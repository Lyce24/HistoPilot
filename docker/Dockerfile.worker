# syntax=docker/dockerfile:1
#
# HistoPilot with CUDA: the Task Center runner and the compute it starts (training, result
# collection, refits, predictor runs, attention), plus everything in the CPU image. compose.yaml
# also runs the service from this image, because the service plans GPU work by probing this
# training environment. TRIDENT feature extraction and SDPC slides are not included. See
# docs/deployment.md#containers.
#
#   docker build -f docker/Dockerfile.worker -t histopilot-worker .

ARG CUDA_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04
ARG NODE_IMAGE=node:24-slim
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.10.2

FROM ${UV_IMAGE} AS uv

# The browser UI, built as checks.yml builds it for the wheel.
FROM ${NODE_IMAGE} AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# The locked training environment. Python 3.11 is uv's own build: the CPU image's version, so
# both images install HistoPilot at the same path.
FROM ${CUDA_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON=3.11 \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PROJECT_ENVIRONMENT=/opt/histopilot/.venv
RUN uv python install --no-bin 3.11
WORKDIR /src
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-dev --no-editable --no-install-project --extra training --extra imaging
COPY . .
COPY --from=web /src/web/dist web/dist
RUN /opt/histopilot/.venv/bin/python scripts/bundle_web.py
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev --no-editable --extra training --extra imaging
# The installed package carries what checks.yml checks in the wheel, and the training
# environment imports what the service's runtime probe imports.
RUN /opt/histopilot/.venv/bin/python - <<'PY'
from importlib.resources import files
import torch, lightning, h5py, pyarrow, sklearn  # noqa: F401
package = files("histopilot")
assert package.joinpath("static/index.html").is_file()
assert package.joinpath("resources/blca_demo_workspace.json").is_file()
for page in ("agents", "cli-contract", "error-codes", "methods", "user-guide"):
    assert package.joinpath(f"resources/docs/{page}.md").is_file(), page
PY

FROM ${CUDA_IMAGE}
ARG HISTOPILOT_UID=1000
ARG HISTOPILOT_GID=1000
LABEL org.opencontainers.image.title="HistoPilot worker" \
      org.opencontainers.image.description="HistoPilot Task Center runner and CUDA compute workers" \
      org.opencontainers.image.source="https://github.com/Lyce24/HistoPilot" \
      org.opencontainers.image.licenses="MIT"
# Ubuntu images ship user 1000 ("ubuntu"); the service user takes its place, so files the
# runner writes in shared volumes belong to the same user as in the CPU image.
RUN if id -u ubuntu >/dev/null 2>&1; then userdel --remove ubuntu 2>/dev/null || true; fi \
 && if getent group ubuntu >/dev/null; then groupdel ubuntu; fi \
 && groupadd --gid "${HISTOPILOT_GID}" histopilot \
 && useradd --uid "${HISTOPILOT_UID}" --gid histopilot --create-home --shell /usr/sbin/nologin histopilot \
 && install -d -o histopilot -g histopilot -m 0700 \
      /var/lib/histopilot /var/lib/histopilot/state /var/lib/histopilot/workspace /var/lib/histopilot/tmp \
 && install -d -o histopilot -g histopilot -m 0755 /data
COPY --from=build /opt/python /opt/python
COPY --from=build /opt/histopilot/.venv /opt/histopilot/.venv
# The same state, workspace and temporary folders as the CPU image: a service and a runner
# share the Task Center store, the lease registry and output locks through them.
ENV PATH=/opt/histopilot/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    HISTOPILOT_CONTAINER=1 \
    HISTOPILOT_PORT=8787 \
    HISTOPILOT_URL=http://127.0.0.1:8787 \
    HISTOPILOT_STATE_DIR=/var/lib/histopilot/state \
    HISTOPILOT_TASK_CENTER_AUTOSTART=0 \
    HISTOPILOT_TRAINING_PYTHON=/opt/histopilot/.venv/bin/python \
    TMPDIR=/var/lib/histopilot/tmp
USER histopilot
WORKDIR /home/histopilot
VOLUME ["/var/lib/histopilot/state", "/var/lib/histopilot/workspace"]
EXPOSE 8787
# Healthy while a runner holds the runner lock. A service started from this image replaces
# this check with the CPU image's HTTP one (see compose.yaml).
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD ["python", "-c", "import sys; from histopilot.taskcenter.launcher import runner_alive; sys.exit(0 if runner_alive() else 1)"]
ENTRYPOINT ["histopilot"]
CMD ["runner", "run"]
